<Window x:Class="аудіобібліотека_голоси_природи.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аудіобібліотека: Голоси природи" Height="550" Width="900" 
        x:Name="RootWindow" Background="#F4F7F4"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ForestButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidePanel" Grid.Column="0" Background="#E0EEE0" CornerRadius="0,25,25,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
                    <TextBlock Text="🌿" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LogoText" Text="Голоси природи" Foreground="#1B261E" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="MenuLabel" Text="МЕНЮ" Foreground="#78A678" FontSize="10" FontWeight="Bold" Margin="10,0,0,10"/>
                    <Button Content="🏠 Головна" Style="{StaticResource ForestButtonStyle}" Background="#C8E6C8"/>
                    <Button x:Name="BtnForest" Content="🌲 Ліс" Style="{StaticResource ForestButtonStyle}" Margin="0,5"/>
                    <Button x:Name="BtnWater" Content="🌊 Вода" Style="{StaticResource ForestButtonStyle}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="🌿🍃🌿" Foreground="#C8E6C8" 
                           FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.4" Margin="0,0,0,20"/>

                <Border Grid.Row="3" x:Name="ThemePanel" Background="#C8E6C8" CornerRadius="20" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="#78A678" BorderThickness="0" Click="DayButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,4">
                                <TextBlock Text="☀️" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="День" FontWeight="Bold" Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Click="NightButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,4">
                                <TextBlock Text="🌙" FontSize="14" Margin="0,0,5,0" Opacity="0.5"/>
                                <TextBlock x:Name="NightBtnText" Text="Ніч" Foreground="#2D3436" Opacity="0.5" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="MainTitle" Text="Бібліотека звуків" FontSize="22" FontWeight="Bold" Foreground="#1B261E" Margin="0,0,0,20"/>

            <ListBox x:Name="SoundsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Margin="0,0,0,10" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0EEE0" CornerRadius="18" Width="36" Height="36">
                                    <TextBlock Text="▶" Foreground="#1B261E" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0,0,0"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#2D3436"/>
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#78A678"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center" Foreground="Gray" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="PlayerBar" Grid.Row="2" Background="White" CornerRadius="18" Margin="0,10,0,0">
                <Grid Margin="20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Зараз грає:" FontSize="10" Foreground="Gray"/>
                        <TextBlock Text="Карпатський ліс" FontWeight="Bold" Foreground="#2D3436"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <Button Content="⏮" Background="Transparent" BorderThickness="0" Margin="10,0" FontSize="18"/>
                            <Button Background="#1B261E" Foreground="White" Width="44" Height="44" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="22"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="▶"/>
                            </Button>
                            <Button Content="⏭" Background="Transparent" BorderThickness="0" Margin="10,0" FontSize="18"/>
                        </StackPanel>
                        <Slider Maximum="100" Value="40" Foreground="#78A678"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🔉" Margin="0,0,5,0"/>
                        <Slider Width="70" Value="80"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>