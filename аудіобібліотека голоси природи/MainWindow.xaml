<Window x:Class="аудіобібліотека_голоси_природи.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аудіобібліотека: Голоси природи" Height="600" Width="950" 
        x:Name="RootWindow" Background="#F4F7F4"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ForestButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidePanel" Grid.Column="0" Background="#E0EEE0" CornerRadius="0,30,30,0" Grid.ColumnSpan="2" Margin="0,0,683,0">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,35">
                    <TextBlock Text="🌿" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LogoText" Text="Голоси природи" Foreground="#1B261E" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" x:Name="MenuStack">
                    <TextBlock Text="МЕНЮ" Foreground="#78A678" FontSize="11" FontWeight="Bold" Margin="12,0,0,12"/>
                    <Button x:Name="BtnHome" Content="🏠 Головна" Style="{StaticResource ForestButtonStyle}" Background="#C8E6C8" Click="Filter_Click"/>
                    <Button x:Name="BtnForest" Content="🌲 Ліс" Style="{StaticResource ForestButtonStyle}" Margin="0,8" Click="Filter_Click"/>
                    <Button x:Name="BtnWater" Content="🌊 Вода" Style="{StaticResource ForestButtonStyle}" Click="Filter_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="2" x:Name="DecorLeaves" Text="🍃" Foreground="#C8E6C8" 
                           FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.3" Margin="0,0,0,30"/>

                <Border Grid.Row="3" x:Name="ThemePanel" Background="#C8E6C8" CornerRadius="22" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DayBtn" Grid.Column="0" Background="#78A678" BorderThickness="0" Height="34" Click="DayButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="17"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="☀️ День" FontWeight="Bold" Foreground="White" FontSize="12"/>
                        </Button>
                        <Button x:Name="NightBtn" Grid.Column="1" Background="Transparent" BorderThickness="0" Height="34" Click="NightButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="17"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="MoonIcon" Text="🌙" FontSize="13" Margin="0,0,5,0" Opacity="0.6"/>
                                <TextBlock x:Name="NightBtnText" Text="Ніч" Foreground="#2D3436" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="120"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="MainTitle" Text="Бібліотека звуків" FontSize="26" FontWeight="Bold" Foreground="#1B261E" Margin="0,0,0,25"/>

            <ListBox x:Name="SoundsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Background}" 
        CornerRadius="15" Margin="0,0,5,12" Padding="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Button Click="PlayButton_Click" Background="#E0EEE0" BorderThickness="0" Width="40" Height="40">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="20"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="▶" Foreground="#1B261E" FontSize="14" HorizontalAlignment="Center" Margin="2,0,0,0"/>
                                </Button>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#2D3436"/>
                                    <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#78A678"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center" Foreground="#A0A0A0" HorizontalAlignment="Right" FontSize="13"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="PlayerBar" Grid.Row="2" Background="White" CornerRadius="25" Margin="0,5,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.1"/>
                </Border.Effect>
                <Grid Margin="25,0,25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NowPlayingLabel" Text="Зараз грає:" FontSize="10" Foreground="Gray" FontWeight="Bold"/>
                        <TextBlock x:Name="PlayingNow" Text="..." FontWeight="Bold" Foreground="#1B261E" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="97">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button Content="⏮" Click="Prev_Click" Background="Transparent" BorderThickness="0" Margin="15,0" FontSize="20" Cursor="Hand"/>
                            <Button x:Name="BtnPlayPause" Background="#1B261E" Foreground="White" Width="48" Height="48" BorderThickness="0" Click="PlayPause_Click" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="24"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock x:Name="PlayPauseIcon" Text="▶" FontSize="20" Margin="3,0,0,0"/>
                            </Button>
                            <Button Content="⏭" Click="Next_Click" Background="Transparent" BorderThickness="0" Margin="15,0" FontSize="20" Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeStatus" Text="0:00 / 0:00" Foreground="#78A678" FontSize="11" Width="50" Height="20"/>
                        <Slider x:Name="TimelineSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" 
                                PreviewMouseLeftButtonUp="TimelineSlider_MouseUp" Cursor="Hand" Height="23"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="VolIcon" Text="🔉" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Slider Width="90" Value="0.8" Minimum="0" Maximum="1" ValueChanged="Volume_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>